{
  "attribution": "Baysöz Labs <baysozlabs@proton.me>",
  "format_version": "1.2",
  "terraform_version": "1.10.5",
  "resource_changes": [
    {
      "address": "aws_iam_role.deploy",
      "mode": "managed",
      "type": "aws_iam_role",
      "name": "deploy",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "dependencies": ["aws_iam_policy.admin"],
      "change": {
        "actions": ["create"],
        "before": {},
        "after": {
          "name": "deploy-role",
          "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"*\"},\"Action\":\"sts:AssumeRole\"}]}"
        }
      }
    },
    {
      "address": "aws_iam_policy.admin",
      "mode": "managed",
      "type": "aws_iam_policy",
      "name": "admin",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "change": {
        "actions": ["create"],
        "before": {},
        "after": {
          "name": "admin-policy",
          "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\"},{\"Effect\":\"Allow\",\"Action\":[\"iam:PassRole\",\"lambda:CreateFunction\"],\"Resource\":\"*\"}]}"
        }
      }
    },
    {
      "address": "aws_security_group.ssh",
      "mode": "managed",
      "type": "aws_security_group",
      "name": "ssh",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "change": {
        "actions": ["create"],
        "before": {},
        "after": {
          "name": "ssh",
          "ingress": [
            {
              "from_port": 22,
              "to_port": 22,
              "protocol": "tcp",
              "cidr_blocks": ["0.0.0.0/0"]
            }
          ]
        }
      }
    },
    {
      "address": "aws_db_instance.primary",
      "mode": "managed",
      "type": "aws_db_instance",
      "name": "primary",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "change": {
        "actions": ["delete", "create"],
        "before": {"encrypted": true, "storage_encrypted": true},
        "after": {
          "encrypted": false,
          "storage_encrypted": false,
          "publicly_accessible": true
        }
      }
    },
    {
      "address": "aws_instance.app",
      "mode": "managed",
      "type": "aws_instance",
      "name": "app",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "dependencies": ["aws_security_group.ssh", "aws_db_instance.primary"],
      "change": {
        "actions": ["update"],
        "before": {"tags": {"tier": "web"}},
        "after": {
          "tags": {"tier": "web", "owner": "platform"},
          "security_groups": ["${aws_security_group.ssh.id}"],
          "db_endpoint": "${aws_db_instance.primary.endpoint}"
        }
      }
    }
  ]
}
